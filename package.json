{
  "name": "mocker",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "extension"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "e2e": "npm run build -w extension && node e2e/run.mjs",
    "screenshots": "npm run build -w extension && node docs/screenshots.mjs"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "devDependencies": {
    "playwright-core": "^1.62.1"
  }
}
