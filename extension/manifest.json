{
  "manifest_version": 3,
  "name": "Mocker",
  "version": "0.1.0",
  "description": "Scenario-based network mocking driven by files in your repo",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://localhost/*", "https://localhost/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Mocker"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "https://localhost/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://localhost/*", "https://localhost/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
